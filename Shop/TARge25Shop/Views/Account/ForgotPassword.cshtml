@model TARge25Shop.Models.Account.ForgotPasswordViewModel

<div class="row">
    <div class="col-md-12">
        <h1>Forgot Password</h1>
        <a>Enter your email and we will send you a reset link</a>
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email">Email aadress</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div>
                <button type="submit" class="btn btn-primary">
                    Send reset link
                </button>
            </div>
        </form>
    </div>
</div>