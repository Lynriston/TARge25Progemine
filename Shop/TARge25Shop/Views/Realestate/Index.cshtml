@model IEnumerable<TARge25Shop.Models.RealEstate.RealestateIndexViewModel>

<div>
    <a asp-action="create" asp-controller="realestate" id="CreateInIndex" type="submit" class="btn btn-primary">Create</a>
</div>

@{
    short rowNumber = 1;
}

<div class="h1">
    Real Estate
</div>
<form method="get">
    <table id="IndexTable" class="table table-hover">
        <thead>
            <tr>
                <th id="IndexRowNumberColumn" scope="col">Nr</th>
                <th id="IndexNameColumn" scope="col">Name</th>
                <th id="IndexLocationColumn" scope="col">Location</th>
                <th id="IndexRoomNumberColumn" scope="col">Room Nr.</th>
                <th id="IndexTypeColumn" scope="col">Type</th>
                <th id="IndexActionColumn" scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var realestate in Model)
            {
                <tr>
                    <td id="IndexRowNumberRealEstate">@rowNumber</td>
                    <td id="IndexNameRealEstate">@realestate.Name</td>
                    <td id="IndexAreaRealEstate">@realestate.Area</td>
                    <td id="IndexLocationRealEstate">@realestate.Location</td>
                    <td id="IndexRoomNumberRealEstate">@realestate.RoomNumber</td>
                    <td id="IndexBuildingTypeRealEstate">@realestate.BuildingType</td>
                    <td>@realestate.CreatedAt</td>
                    <td id="IndexActionRealEstate">
                        <a id="IndexRealEstateDetails" asp-action="details" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-primary">Details</a>
                        <a id="IndexRealEstateUpdate" asp-action="update" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-primary">Update</a>
                        <a id="IndexRealEstateDelete" asp-action="delete" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-outline-danger">Delete</a>
                    </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>