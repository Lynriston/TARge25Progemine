@model TARge25Shop.Models.RealEstate.RealestateCreateUpdateViewModel

<div>
    Real Estate Create
</div>

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" id="CU_NameEntryRealEstate" class="form-control" />
        </div>
    </div>
    <div class="form-group row">
        <label asp-for="Area" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Area" id="CU_AreaEntryRealEstate" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Location" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Location" id="CU_LocationEntryRealEstate" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="RoomNumber" id="CU_RoomNumberEntryRealEstate" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuildingType" id="CU_BuildingTypeEntryRealEstate" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Files" class="control-label"></label>
        <input asp-for="Files" multiple type="file" class="form-control" />
    </div>

    <div>
        @foreach (var image in Model.Images)
        {
            <partial name="_Images" model="image" />
            <input asp-action="removeImage" asp-controller="realEstate" asp-route-imageId="@image.ImageId"
                   type="submit" class="btn btn-danger" value="Remove Image" />
        }
    </div>

    @if (Model.Id.HasValue)
    {
        <input asp-action="update" asp-controller="realestate" id="CU_UpdateRealEstate" type="submit" class="btn btn-success" value="Update" />
    }
    else
    {
        <input asp-action="create" asp-controller="realestate" id="CU_CreateRealEstate" type="submit" class="btn btn-success" value="Create" />
    }

    <a asp-action="Index" asp-controller="realestate" class="btn btn-secondary">Back to List</a>
</form>