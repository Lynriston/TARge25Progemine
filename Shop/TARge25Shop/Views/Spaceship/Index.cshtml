@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

<div>
    <a asp-action="create" asp-controller="spaceship" 
    type="submit" 
    class="btn btn-outline-primary" 
    style="--bs-btn-padding-y: .25rem; --bs-btn-padding-x: .5rem; --bs-btn-font-size: .75rem;"
    >Create</a>
</div>

@{
    short rowNumber = 1;
}

<div class="h1 text-bold text-capitalize">
    Spaceships
</div>
<form method="get">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@spaceship.Name</td>
                    <td>@spaceship.ShipType</td>
                    <td>@spaceship.CreatedAt</td>
                    <td>@spaceship.Crew</td>
                    <td>
                        <a asp-action="details" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-info btn-sm">Update</a>
                        <a asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                    </td>
                </tr>
                    rowNumber += 1;
                }
        </tbody>
    </table>
</form>