@model TARge25Shop.Models.Spaceship.SpaceshipDetailsViewModel

<div class="container mt-4">
    <h4>Spaceship Details</h4>
    <hr />
    <div class="card shadow-sm p-4 mb-4 .bg-light.bg-gradient">
        <dl class="row mb-0">
            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.ShipType)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.ShipType)</dd>

            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.Crew)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Crew)</dd>

            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.EnginePower)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.EnginePower)</dd>

            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedAt)</dd>

            <dt class="col-sm-2 text-truncate">@Html.DisplayNameFor(model => model.UpdatedAt)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.UpdatedAt)</dd>
        </dl>
    </div>

    @foreach (var images in Model.Images)
    {
        <partial name="_Images" model="images" />
    }

    <dl>
        @foreach (var images in Model.Images)
        {
            <partial name="_Images" model="images" />
        }
    </dl>

    <a asp-action="Index" asp-controller="spaceship" class="btn btn-outline-success">Back to List</a>
</div>