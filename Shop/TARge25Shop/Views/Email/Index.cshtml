@model TARge25Shop.Models.Email.EmailViewModel

<div class="h1">
    Send Email
</div>
<div>
    <form method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label asp-for="To"></label>
            <input asp-for="To" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Subject"></label>
            <input asp-for="Subject" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Body"></label>
            <textarea asp-for="Body" class="form-control"></textarea>
        </div>
        <div class="form-group">
            <label asp-for="Attachments"></label>
            <input asp-for="Attachments" type="file" multiple class="form-control" />
        </div>
        <input asp-action="sendEmail" asp-controller="email" type="submit" class="btn btn-primary" />
    </form>
</div>