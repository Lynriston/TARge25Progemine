@model TARge25Shop.Models.OpenWeather.OpenWeatherViewModel

<div class="h1">
    OpenWeather
</div>
<div class="container">
    <form asp-action="GetCurrentWeather" method="get">
        <div class="container">
            <div class="form-group col-md-offset-3 col-md-5">
                <h2>Welcome to OpenWeather Site</h2>
                <label asp-for="cityName" style="font-family: Arial">City Name</label>
                <input asp-for="cityName" class="form-control" required />
                <span asp-validation-for="cityName" class="text-danger"></span>
            </div>
        </div>
        <div class="container mt-2">
            <div class="form-group col-md-offset-3 col-md-5">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </div>
    </form>
</div>